# MedDefender Twin configuration. Copy to `.env` (repo root) and adjust.
# Everything here is for a LOCAL, SYNTHETIC demo. Never reuse these values elsewhere.

ENVIRONMENT=development

# Local PostgreSQL (see backend/scripts/local_postgres.py). Docker Compose overrides this.
DATABASE_URL=postgresql+psycopg://meddefender:meddefender-local-dev@127.0.0.1:55432/meddefender

# Root secret used to derive the simulated per-device HMAC keys (KMS stand-in, >= 32 chars).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVICE_KEY_MASTER_SECRET=change-me-to-a-random-value-of-at-least-32-characters

# Demo accounts created by `python -m app.seed` (>= 12 characters each).
DEMO_PASSWORD_VIEWER=viewer-demo-pass-2026
DEMO_PASSWORD_OPERATOR=operator-demo-pass-2026
DEMO_PASSWORD_ADMIN=secadmin-demo-pass-2026

# Browser origins allowed to open the WebSocket (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Set to true when served over HTTPS.
COOKIE_SECURE=false

# Background telemetry generator (simulated devices).
GENERATOR_ENABLED=true
GENERATOR_INTERVAL_SECONDS=5
